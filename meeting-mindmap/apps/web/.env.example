# 서버에만 두는 키 (브라우저로 절대 보내지 않음)
ANTHROPIC_API_KEY=
SONIOX_API_KEY=

# 데스크톱(온라인 버전) 앱이 이 서버의 API를 호출할 수 있도록 허용할 출처 (쉼표 구분)
# 개발 중 Electron 렌더러: http://localhost:5173 , 패키징된 앱(file://): null
ALLOWED_ORIGINS=http://localhost:5173,null

# 선택: 모델 변경
# MINDMAP_MODEL=claude-haiku-4-5
# SUMMARY_MODEL=claude-sonnet-5

# mock STT 사용 (Soniox 키 없을 때, apps/web에서만 동작)
# NEXT_PUBLIC_MOCK_STT=1
